// ShotListr data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Accounts ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions  Session[]
  shotlists Shotlist[]
}

model Session {
  id        String   @id // random token stored in the cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Shotlists ----------

model Shotlist {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows ShotlistRow[]

  @@index([userId])
}

// One spreadsheet row. `kind` is "SCENE" or "SHOT" (src/lib/constants.ts). Scene rows use
// intExt/location/time/characters, shot rows subject/framing/angle/description; the others stay "".
// Scene/shot numbers are derived from row order (src/lib/rows.ts), never stored.
model ShotlistRow {
  id         String @id @default(cuid())
  shotlistId String
  position   Int
  kind       String

  intExt     String @default("")
  location   String @default("")
  time       String @default("")
  characters String @default("")

  subject     String @default("")
  framing     String @default("")
  angle       String @default("")
  description String @default("")

  shotlist Shotlist @relation(fields: [shotlistId], references: [id], onDelete: Cascade)

  @@unique([shotlistId, position])
}
