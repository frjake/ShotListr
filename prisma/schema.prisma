// ShotListr data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Accounts ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions  Session[]
  shotlists Shotlist[]
}

model Session {
  id        String   @id // random token stored in the cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Shotlists ----------

model Shotlist {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows       ShotlistRow[]
  script     Script?
  characters ShotlistCharacter[]

  @@index([userId])
}

// One spreadsheet row. `kind` is "SCENE" or "SHOT" (src/lib/constants.ts). Scene rows use
// sceneNumber/intExt/location/time/characters, shot rows subject/framing/angle/description; the
// others stay "". Scene numbers ("12", "12.1", "12.0.1" — see src/lib/sceneNumbers.ts) are unique
// and increase with position; shot numbers (12A, 12B) are derived, never stored.
model ShotlistRow {
  id         String @id @default(cuid())
  shotlistId String
  position   Int
  kind       String

  sceneNumber String @default("")
  intExt      String @default("")
  location    String @default("")
  time        String @default("")
  characters  String @default("")

  subject     String @default("")
  framing     String @default("")
  angle       String @default("")
  description String @default("")

  shotlist Shotlist @relation(fields: [shotlistId], references: [id], onDelete: Cascade)

  @@unique([shotlistId, position])
}

// The script file attached to a shotlist (at most one). Stored as uploaded and never read or
// converted; only served back for download. Kept out of Shotlist so the bytes load only when asked for.
model Script {
  id         String   @id @default(cuid())
  shotlistId String   @unique
  fileName   String
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now())

  shotlist Shotlist @relation(fields: [shotlistId], references: [id], onDelete: Cascade)
}

// The shotlist's character list, in the user's order (autofill starts it in order of first mention).
// Scene Characters cells list their names in this order. Replaced as a whole on save, like rows.
model ShotlistCharacter {
  id         String @id @default(cuid())
  shotlistId String
  position   Int
  name       String

  shotlist Shotlist @relation(fields: [shotlistId], references: [id], onDelete: Cascade)

  @@unique([shotlistId, position])
}
